// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`dbt generation of the reference project (UC-030) > generates dim_plant exactly as reviewed 1`] = `
"-- Generated by Atlas from project "reference" (format 1). Do not edit: change the spec in Atlas instead.
-- Plant: One row per plant of the group, shared reference data for sales and manufacture.
{{ config(materialized='table') }}

with

branch_sap_fr as (
    select
        cast(/* rule qualified_key */ (array_to_string(array_construct_compact('SAP_FR', ':', nullif(cast(t."WERKS" as varchar), '')), '')) as varchar(52)) as plant_id,
        t."WERKS" as plant_code,
        t."NAME1" as plant_name,
        cast(t."LAND1" as varchar(2)) as country_code,
        cast(coalesce(nullif(trim(t."ORT01"), ''), 'Unknown') as varchar(25)) as city,
        t."REGIO" as region_code,
        cast('SAP S/4HANA' as varchar(20)) as erp_product,
        'SAP_FR' as atlas_source_tag,
        'sap_fr' as atlas_branch,
        1 as atlas_priority
    from {{ source('sap_fr', 't001w') }} as t
),

branch_sap_de as (
    select
        cast(/* rule qualified_key */ (array_to_string(array_construct_compact('SAP_DE', ':', nullif(cast(t."WERKS" as varchar), '')), '')) as varchar(52)) as plant_id,
        t."WERKS" as plant_code,
        t."NAME1" as plant_name,
        cast(t."LAND1" as varchar(2)) as country_code,
        cast(coalesce(nullif(trim(t."ORT01"), ''), 'Unknown') as varchar(25)) as city,
        t."REGIO" as region_code,
        cast('SAP S/4HANA' as varchar(20)) as erp_product,
        'SAP_DE' as atlas_source_tag,
        'sap_de' as atlas_branch,
        2 as atlas_priority
    from {{ source('sap_de', 't001w') }} as t
),

unioned as (
    select * from branch_sap_fr
    union all
    select * from branch_sap_de
)

select
    plant_id,
    plant_code,
    plant_name,
    country_code,
    city,
    region_code,
    erp_product,
    atlas_source_tag as source_system
from unioned
"
`;
